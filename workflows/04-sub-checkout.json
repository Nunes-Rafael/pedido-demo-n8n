      "name": "Recebeu do Orquestrador",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        -544,
        1104
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Recebeu do Orquestrador').first().json;\n\n// 1. Tratamento flexível para os itens\nlet itensFormatado = \"1x Item\";\nconst rawItens = ctx.itens || ctx.itens_pendentes_json || ctx.carrinho || ctx.produtos || ctx.pedido;\n\nif (rawItens) {\n  if (typeof rawItens === 'string') {\n    itensFormatado = rawItens;\n  } else if (Array.isArray(rawItens)) {\n    itensFormatado = rawItens.map(item => {\n      const qtd = item.quantidade || item.qtd || 1;\n      const nome = item.nome || item.produto || item.descricao || 'Item';\n      const precoUnit = item.preco || item.valor || 0;\n      const totalItem = precoUnit * qtd;\n      const precoFormatado = 'R$ ' + Number(totalItem).toFixed(2).replace('.', ',');\n      return `${qtd}x ${nome} - ${precoFormatado}`;\n    }).join('\\n');\n  }\n} else {\n  itensFormatado = ctx.query || ctx.resumo_pedido || \"1x Pedido Geral\";\n}\n\n// 2. Garante a captura correta do Nome, Endereço e Telefone em todas as variações possíveis de chaves\nconst nomeFinal = ctx.nome || ctx.pushName || ctx.nome_cliente || ctx.client_name || \"Não informado\";\nconst telefoneFinal = ctx.telefone || ctx.from || ctx.whatsapp || ctx.sender || ctx.numero_telefone || \"Não informado\";\nconst enderecoFinal = ctx.endereco_resolvido || ctx.endereco_validado || ctx.endereco || \"Não informado\";\n\n// 3. Retorno formatado para a planilha (com o novo campo nome)\nreturn [{\n  data_hora: new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n  nome: nomeFinal,\n  telefone: telefoneFinal,\n  itens: itensFormatado,\n  cep: ctx.cep || ctx.cep_utilizado || ctx.query_cep || \"\",\n  endereco_resolvido: enderecoFinal,\n  distancia_km: ctx.distancia_km !== undefined ? ctx.distancia_km : 0,\n  taxa_entrega: ctx.taxa_entrega !== undefined ? ctx.taxa_entrega : 0,\n  total: ctx.total !== undefined ? ctx.total : (ctx.total_pedido || 0)\n}];"
      },
      "name": "Formatar Itens Legiveis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        1104
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_ME",
          "mode": "list",
          "cachedResultName": "demo-comida",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/REPLACE_ME/edit?usp=drivesdk"
        },
