        "jsCode": "// Extrai sessionId, texto e idioma do payload enviado pelo widget de chat do site.\nconst body = $input.first().json.body || {};\nconst sessionId = String(body.sessionId || '').trim();\nconst mensagem = String(body.text || '').trim();\nconst locale = String(body.locale || '').trim();\nconst valido = Boolean(sessionId && mensagem && locale);\nreturn [{ json: { sessionId, mensagem, locale, valido } }];"
      },
